{
  "name": "gm-game",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gm/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm native:node && pnpm -r test",
    "native:node": "pnpm --filter @gm/data rebuild better-sqlite3",
    "ml:test": "python3 -m unittest discover -s ml/tests -v",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm ml:test",
    "lab": "pnpm --filter @gm/balance-lab lab --",
    "roster:template": "pnpm --filter @gm/balance-lab roster:template",
    "xg:template": "pnpm --filter @gm/balance-lab xg:template",
    "ratings:fit": "pnpm --filter @gm/balance-lab ratings:fit --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
